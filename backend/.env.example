# MintHRM Backend — environment variables
# Copy to .env and fill in real values

APP_NAME=MintHRM Intelligence Platform
DEBUG=true

# API Key
API_KEY=hrm-dev-api-key

# ── Application PostgreSQL (control plane) ─────────────────────────────
# Stores: hrm_control.tenant_registry, tenant_etl_sources, platform config.
# Do NOT use the generic "postgres" database in production.
# Local Docker hrm-postgres often maps host port 5438 -> container 5432
APPLICATION_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5438/hrm_platform
# Legacy alias — keep in sync with APPLICATION_DATABASE_URL for local dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5438/hrm_platform
# PLATFORM_DATABASE_URL=

APP_DATABASE_NAME=hrm_platform
# Application DB is created by DBA / init-db.sh / Docker init — not by the API at runtime.
APP_AUTO_PROVISION=false

# Local uvicorn (no Docker): run Alembic in API lifespan
RUN_MIGRATIONS_ON_STARTUP=true
# Docker / production container: entrypoint runs Alembic (RUN_MIGRATIONS_IN_ENTRYPOINT=true, default)
# RUN_MIGRATIONS_ON_STARTUP=false
# RUN_MIGRATIONS_IN_ENTRYPOINT=true
# If lifespan hangs on --reload, set RUN_MIGRATIONS_ON_STARTUP=false and: cd backend && alembic upgrade head
# MIGRATION_LOCK_TIMEOUT_SEC=45
# Production: set true so the container exits if migrations fail (do not serve a broken schema)
MIGRATION_FAIL_FAST=false
# Only if APP_AUTO_PROVISION=true (local convenience): admin URL on app Postgres to CREATE hrm_platform
# POSTGRES_ADMIN_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres

# ── Per-tenant analytics warehouse (usually a SEPARATE Postgres server) ─
# One Postgres database per tenant: hrm_wh_{tenant_id}
# WAREHOUSE_AUTO_PROVISION=true → app creates hrm_wh_{tenant_id} on first ETL / tenant register.
# Local dev: leave WAREHOUSE_DEFAULT_* empty — warehouse uses the same host as APPLICATION_DATABASE_URL.
# Production: set WAREHOUSE_DEFAULT_HOST + WAREHOUSE_ADMIN_URL on the analytics cluster.
WAREHOUSE_DEFAULT_ISOLATION=database
WAREHOUSE_DB_PREFIX=hrm_wh_
WAREHOUSE_AUTO_PROVISION=true
# WAREHOUSE_ADMIN_URL=postgresql://warehouse_admin:PASSWORD@warehouse-db.internal:5432/postgres
# WAREHOUSE_DEFAULT_HOST=warehouse-db.internal
# WAREHOUSE_DEFAULT_PORT=5432
# WAREHOUSE_DEFAULT_USER=hrm_warehouse_app
# WAREHOUSE_DEFAULT_PASSWORD=
# Fernet key for tenant_registry passwords and database connection credentials
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# ETL source — mysql (default) or postgres
MYSQL_EXTRACTOR_PROFILE=generic
SOURCE_MAPPING_PROFILE=
SOURCE_MAPPING_VARIANT=
SOURCE_TYPE=mysql
SOURCE_HOST=
SOURCE_PORT=3306
SOURCE_DB=
SOURCE_USER=
SOURCE_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_TENANT_ID=demo_tenant

# MySQL ETL extract — keyset chunks avoid long SSCursor net_write_timeout drops
# ETL_MYSQL_CHUNK_SIZE=10000
# ETL_PG_BATCH_SIZE=2000
# ETL_MYSQL_CONNECT_TIMEOUT_SEC=30
# ETL_MYSQL_READ_TIMEOUT_SEC=3600
# ETL_MYSQL_WRITE_TIMEOUT_SEC=3600
# ETL_MYSQL_SESSION_INIT=SET SESSION net_read_timeout=3600, net_write_timeout=3600, wait_timeout=28800
# ETL_EXTRACT_MAX_RETRIES=3
# ETL_EXTRACT_RETRY_BASE_SEC=2.0

# AI Backend
# ollama = hosted gpt-oss on ai-core (same as mint-analytics). minchy = LiteLLM proxy (needs valid AI_PROXY_API_KEY).
EXPERIENCE_LLM_BACKEND=ollama
EXPERIENCE_LLM_USER=mint-analytics-dev
OLLAMA_URL=https://ai-core.minchy.ai
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_AUTH=
MINCHY_AI_BASE_URL=https://ai-proxy.minchy.ai
MINCHY_AI_API_KEY=
MINCHY_AI_MODEL=gpt-oss
INTERPRETER_PROVIDER=off
ANTHROPIC_API_KEY=
ANTHROPIC_INTERPRETER_MODEL=claude-haiku-4-5
ANTHROPIC_API_BASE=https://api.anthropic.com

CORS_ORIGINS=["http://localhost:5174","http://localhost:5173","http://localhost:3001"]

# ── Datamart AI Assistant (text-to-SQL on analytics warehouse) ─────
# Read-only PostgreSQL warehouse (separate from APPLICATION_DATABASE_URL app DB).
# Local tenant ETL: point at hrm_wh_{tenant_id} on the same Postgres as app (port 5438).
# DATAMART_DB_HOST=localhost
# DATAMART_DB_PORT=5438
# DATAMART_DB_NAME=hrm_wh_demo_tenant
DATAMART_DB_HOST=139.162.17.40
DATAMART_DB_PORT=10000
DATAMART_DB_NAME=hrm_wh_demo_tenant
DATAMART_DB_USER=mint_bi_reader
DATAMART_DB_PASSWORD=your-warehouse-password
# Tenant warehouse DB (not a schema). Default: hrm_wh_{DATAMART_DEFAULT_TENANT_ID}
# DATAMART_DB_NAME=hrm_wh_demo_tenant
DATAMART_DEFAULT_TENANT_ID=demo_tenant
# tenant_etl (default) | legacy_audit | auto
DATAMART_PROFILE=tenant_etl
DATAMART_QUERY_SCHEMAS=hr_semantic,hr,hr_snap
DATAMART_PRIMARY_SCHEMA=hr_semantic
# Do not fall back to legacy public_mint_audit single-schema mode
DATAMART_LEGACY_FALLBACK=false
DATAMART_METADATA_CACHE_TTL_SEC=900
# Resolve warehouse from hrm_control.tenant_registry (recommended)
DATAMART_USE_TENANT_REGISTRY=true
DATAMART_PREFER_TENANT_REGISTRY=true
# After ETL: python tools/seed_demo_tenant_registry_warehouse.py
# Catalog: python tools/semantic_catalog_tool.py refresh --tenant demo_tenant --write
# Deprecated — only if DATAMART_PROFILE=legacy_audit:
# DATAMART_SCHEMA=public_mint_audit

# Auth (Phase 9) — mock headers vs JWT
MOCK_AUTH_ENABLED=true
SECRET_KEY=hrm-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HRIS launch (MinHRM PHP → /auth?payload=) — same base64 key as PHP self::$secretKey
# Must be stable in PHP (env/config), not regenerated per request.
# HRIS_LAUNCH_SECRET_KEY=
# During rotation: current key first, then previous (comma-separated, no spaces)
# HRIS_LAUNCH_SECRET_KEYS=current_b64,previous_b64
# HRIS_WAREHOUSE_PERMISSION=warehouse_access
# HRIS_LAUNCH_CLOCK_SKEW_SEC=30
# HRIS_LAUNCH_AUTO_PROVISION_TENANT=false
# Datamart: false = allow demo_tenant without X-Tenant-Id (dev only)
DATAMART_DEFAULT_USER_ID=default-user
DATAMART_REQUIRE_TENANT_HEADER=false
# Production datamart: MOCK_AUTH_ENABLED=false, DATAMART_REQUIRE_TENANT_HEADER=true, use Bearer JWT
# Issue dev token: python tools/create_dev_jwt.py --tenant-id demo_tenant --user-id my-user

# Phase 10 live smoke (tools/smoke_datamart_phase10.py, pytest -m live)
# DATAMART_LIVE_TEST=1
# DATAMART_LIVE_TENANT_ID=demo_tenant
# DATAMART_LIVE_EXPECT_PROFILE=tenant_etl
# DATAMART_SMOKE_URL=http://127.0.0.1:8000
# DATAMART_LIVE_CHAT=1

# DataHub GMS for table discovery (optional — see DATAHUB_SETUP.md)
DATAHUB_GMS_URL=http://localhost:8080
# auto = skip localhost GMS without PAT (saves ~25s/chat); true when DataHub is running
DATAMART_USE_DATAHUB=auto
DATAMART_TABLE_LIST_CACHE_TTL_SEC=300

# Optional alias for Minchy key (used when EXPERIENCE_LLM_BACKEND=minchy)
AI_PROXY_API_KEY=
# Hosted Ollama (ai-core) requires a model tag — bare gpt-oss returns 404.
DATAMART_LLM_MODEL=gpt-oss
DATAMART_CHAT_MODEL=gpt-oss:20b
DATAMART_TEMPLATE_MODEL=gpt-oss:20b
DATAMART_REPAIR_MODEL=gpt-oss:20b
DATAMART_TEMPLATE_MODEL=gpt-oss:20b
DATAMART_REPAIR_MODEL=gpt-oss:20b
DATAMART_LLM_CONTEXT_TOKENS=4096
DATAMART_LLM_COMPLETION_RESERVE=900
DATAMART_CHARS_PER_TOKEN=3.2
DATAMART_MAX_SQL_RETRIES=2
# Cap warehouse SELECT runtime (seconds); avoids endless "Run query on warehouse" spinner
DATAMART_WAREHOUSE_CONNECT_TIMEOUT_SEC=15
DATAMART_WAREHOUSE_STATEMENT_TIMEOUT_SEC=60
# Validation: retrieval coverage + SQL faithfulness on DatamartResponse.validation
DATAMART_VALIDATION_ENABLED=true
DATAMART_VALIDATION_ENFORCE_RETRIEVAL=false
DATAMART_VALIDATION_FAITHFULNESS=true
DATAMART_VALIDATION_CRITIC=false
DATAMART_VALIDATION_RELEVANCE_FILTER=false
DATAMART_VALIDATION_STRICT_BINDING=false
DATAMART_VALIDATION_VERIFIED_METRICS=false
DATAMART_VALIDATION_BLOCK_INSUFFICIENT_EXEC=true
DATAMART_VALIDATION_REQUIRE_ADEQUACY=true
# ReportSpec compile + catalog routing + pre-execute domain gates (recommended).
DATAMART_REPORT_SPEC_ENABLED=true

# Optional local dogfood (uncomment to try confirm-sources / critic):
# DATAMART_VALIDATION_CRITIC=true
# DATAMART_VALIDATION_ENFORCE_RETRIEVAL=false
