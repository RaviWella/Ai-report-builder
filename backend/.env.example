# =============================================================================
# MintHRM Report Builder — environment template
#
# Copy to `backend/.env` for local dev. In PRODUCTION do NOT ship a .env file —
# inject these as real env vars / secrets (GitLab CI/CD variables, K8s Secrets,
# Vault). Lines marked  🔒 SECRET  must come from the secret store, never git.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=MintHRM Report Builder
ENVIRONMENT=production            # local | staging | production
DEBUG=false
LOG_JSON=true

# ── Auth ──────────────────────────────────────────────────────────────────
# In production the parent MintHRM platform authenticates the caller; the
# identity arrives in `Authorization: Bearer <JWT>`. DEV_AUTH_BYPASS MUST be
# false in production (it is also force-ignored whenever ENVIRONMENT=production).
DEV_AUTH_BYPASS=false
# DEV_TENANT_ID / DEV_USER_ID / DEV_ROLE are only read when DEV_AUTH_BYPASS=true.
JWT_SECRET=change-me-strong-random        # 🔒 SECRET (shared with the JWT issuer)
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_LEEWAY_SECONDS=86400  # allow /auth/refresh after JWT exp while HRIS session is valid

# ── Metadata DB (schema-per-tenant PostgreSQL 16/17) ───────────────────────
METADATA_DB_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/minthrm_reports   # 🔒 SECRET (password)
PG_TEMPLATE_SCHEMA=public
PG_AUTO_MIGRATE=false
PG_ALLOW_UNREGISTERED_TENANTS=true   # dev/local only
PG_PROVISION_API_KEY=                # protect POST /platform/internal/tenants/{subdomain}/provision
# Per process. Production CMD is 4 Gunicorn workers — max metadata connections
# ≈ workers × (size + overflow) plus Celery. Stay under Postgres max_connections.
PG_POOL_SIZE=5
PG_POOL_MAX_OVERFLOW=15
PG_POOL_TIMEOUT_SECONDS=10

# ── Datamart read replica — READ-ONLY user (per-tenant DB mint_{tenant}) ───
# Reporting must use a read-only DB user with SELECT on the mart + core schemas.
DATAMART_RO_URL=postgresql+psycopg://readonly_user:PASSWORD@HOST:5432/mint_control   # 🔒 SECRET (password)
DATAMART_DB_PATTERN=mint_{tenant_key}   # "" => single-DB schema scoping
DATAMART_SCHEMA_SEMANTIC=mart
DATAMART_SCHEMA_CORE=core

# ── Query Engine guards ───────────────────────────────────────────────────
QUERY_ROW_LIMIT=50000
PREVIEW_ROW_LIMIT=100
QUERY_STATEMENT_TIMEOUT_MS=30000
DATAMART_POOL_SIZE=5
DATAMART_POOL_MAX_OVERFLOW=5

# ── Redis / Celery (worker + nightly semantic refresh + scheduled exports) ─
REDIS_URL=redis://HOST:6379/0
CELERY_BROKER_URL=redis://HOST:6379/1
CELERY_RESULT_BACKEND=redis://HOST:6379/2

# ── AI Adapter (metadata-only; ZDR + BAA at contract time) ────────────────
AI_PROVIDER=selfhosted            # anthropic | selfhosted
AI_MODEL=claude-opus-4-8          # used when AI_PROVIDER=anthropic
AI_MAX_TOKENS=2400
ANTHROPIC_API_KEY=                # 🔒 SECRET — optional fallback; UI-entered keys take precedence
# Self-hosted (vLLM / internal proxy) when AI_PROVIDER=selfhosted:
SELFHOSTED_BASE_URL=https://ai-proxy.minchy.ai
SELFHOSTED_MODEL=gpt-oss
SELFHOSTED_API_KEY=                # 🔒 SECRET — Bearer token for internal AI proxy, if required
SELFHOSTED_CONTEXT=4096           # total context window (input+output); raise for bigger models

# 🔒 SECRET — Fernet key that encrypts UI-entered AI provider keys AT REST.
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP IT STABLE & BACKED UP — losing it means stored AI keys can't be decrypted.
AI_CONFIG_ENC_KEY=

# ── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
