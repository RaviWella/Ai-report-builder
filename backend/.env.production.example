# MintHRM Backend — PRODUCTION environment template
# Copy to .env on the API server and replace every CHANGE_ME / example host.
# Do NOT commit the filled .env file to git.
#
# Architecture:
#   - Application DB  → control plane (tenants, ETL registry) on app-pg host — DBA creates once
#   - Warehouse DB    → analytics per tenant (hrm_wh_*) — auto-created per tenant if needed
#   - Source DBs      → configured per tenant in UI (Settings → ETL Sources), not here
#
# Provisioning: APP_AUTO_PROVISION=false | WAREHOUSE_AUTO_PROVISION=true

APP_NAME=MintHRM Intelligence Platform
DEBUG=false

# ── Security ───────────────────────────────────────────────────────────
API_KEY=CHANGE_ME_long_random_api_key
SECRET_KEY=CHANGE_ME_jwt_secret_min_32_chars
DB_ENCRYPTION_KEY=CHANGE_ME_fernet_key
# Generate Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Application PostgreSQL (control plane) — SERVER 1 ─────────────────
# DBA creates hrm_platform once. Alembic runs once in docker-entrypoint.sh on container start.
# When APPLICATION_DATABASE_URL is set, its URL path is the app DB; APP_DATABASE_NAME is informational.
APPLICATION_DATABASE_URL=postgresql+psycopg2://hrm_app:CHANGE_ME@app-pg.prod.example.com:5432/hrm_platform?sslmode=require
APP_DATABASE_NAME=hrm_platform
APP_AUTO_PROVISION=false
RUN_MIGRATIONS_IN_ENTRYPOINT=true
RUN_MIGRATIONS_ON_STARTUP=false
MIGRATION_FAIL_FAST=true
# POSTGRES_ADMIN_URL not required when APP_AUTO_PROVISION=false

# ── Analytics warehouse PostgreSQL — SERVER 2 (separate from app) ─────
# Per-tenant DB hrm_wh_{tenant_id} — auto-created on first ETL when WAREHOUSE_AUTO_PROVISION=true
WAREHOUSE_DEFAULT_ISOLATION=database
WAREHOUSE_DB_PREFIX=hrm_wh_
WAREHOUSE_AUTO_PROVISION=true
WAREHOUSE_ADMIN_URL=postgresql://postgres_admin:CHANGE_ME@warehouse-pg.prod.example.com:5432/postgres
# Set this if the maintenance DB in WAREHOUSE_ADMIN_URL is not postgres.
WAREHOUSE_ADMIN_DATABASE=postgres
WAREHOUSE_DEFAULT_HOST=warehouse-pg.prod.example.com
WAREHOUSE_DEFAULT_PORT=5432
WAREHOUSE_DEFAULT_USER=hrm_warehouse_app
WAREHOUSE_DEFAULT_PASSWORD=CHANGE_ME

# Optional: legacy script-only source defaults (prefer UI → ETL Sources in production)
MYSQL_EXTRACTOR_PROFILE=minthrm
SOURCE_MAPPING_PROFILE=
SOURCE_MAPPING_VARIANT=
SOURCE_TYPE=
SOURCE_HOST=
SOURCE_PORT=
SOURCE_DB=
SOURCE_USER=
SOURCE_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_TENANT_ID=

# ── AI / Experience (production: Minchy proxy recommended) ────────────
EXPERIENCE_LLM_BACKEND=minchy
EXPERIENCE_LLM_MODEL=qwen3.5-128k
EXPERIENCE_LLM_USER=mint-hrm-prod
MINCHY_AI_BASE_URL=https://ai-proxy.minchy.ai
MINCHY_AI_API_KEY=CHANGE_ME
MINCHY_AI_MODEL=qwen3.5-128k
INTERPRETER_PROVIDER=off
ANTHROPIC_API_KEY=
ANTHROPIC_INTERPRETER_MODEL=claude-haiku-4-5
ANTHROPIC_API_BASE=https://api.anthropic.com

# Local Ollama — not used when EXPERIENCE_LLM_BACKEND=minchy
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=65536

EMBEDDING_MODEL=nomic-embed-text:latest
RETRIEVAL_TOP_K=15

# ── CORS — your production frontend origin(s) ─────────────────────────
CORS_ORIGINS=["https://mint-hrm.yourcompany.com"]
