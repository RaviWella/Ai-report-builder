# Local dev (Vite proxies /api → backend)
REACT_APP_API_BASE_URL=/api/v1

# Production split hosts (set at Docker/CI build — preferred):
# REACT_APP_API_BASE_URL=https://mint-analytics-new-api.minchy.ai/api/v1

REACT_APP_API_KEY=hrm-dev-api-key
REACT_APP_TENANT_ID=demo_tenant
# Optional workspace user (backend defaults to default-user when mock auth is on)
REACT_APP_USER_ID=default-user

# Optional: if backend runs on a non-default port
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: confirm grounded tables before a new question (recommended for local dogfood)
REACT_APP_DATAMART_GROUNDING_CONFIRM=true

# Local dev: skip HRIS /auth launch (pairs with MOCK_AUTH_ENABLED=true on backend)
REACT_APP_SKIP_AUTH=true

# Datamart dev: MOCK_AUTH_ENABLED=true on API — API key is enough; X-Tenant-Id optional.
# Configure warehouse + LLM vars in backend/.env (DATAMART_*, DATAHUB_*, AI_PROXY_API_KEY).
