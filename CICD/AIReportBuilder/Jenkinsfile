pipeline {
    agent any

    parameters {
        booleanParam(name: 'FORCE_BUILD_ALL', defaultValue: false, description: 'Build, push, and deploy all app containers, ignoring detected file changes.')
    }

    environment {
        DOCKER_BUILDKIT = '1'

        // Same container registry/repo as staging; tags below keep this branch isolated.
        GITLAB_REGISTRY = 'registry.minthrm.com'
        GITLAB_IMAGE = 'registry.minthrm.com/staging/mint-analytics-v1.5'

        APP_NAME = 'mint-analytics-v1.5-report-builder'
        ENV_NAME = 'ai-report-builder'

        SSH_CREDENTIALS_ID = 'mint-ai-server-ssh'
        REMOTE_HOST_CREDENTIALS_ID = 'mint-thirdparty-server-host'
        REGISTRY_CREDENTIALS_ID = 'gitlab-registry-credentials'
        DISCORD_WEBHOOK_CREDENTIALS_ID = 'discord-webhook-cicd'

        DOCKER_NETWORKS = 'mint_staging_network,traefik-network,dev_db_network'
        BACKEND_ENV_FILE_PATH = '/home/deploy/MintHRM/Staging/Analytics/Env/v1.5-report-builder.env'

        FRONTEND_API_BASE_URL = 'https://mint-analytics-v2.minchy.ai/api/v1'
        BACKEND_PUBLIC_HEALTH_URL = 'https://mint-analytics-v2.minchy.ai/health'

        FRONTEND_IMAGE_TAG = "${GITLAB_IMAGE}:frontend-${ENV_NAME}"
        BACKEND_IMAGE_TAG = "${GITLAB_IMAGE}:backend-${ENV_NAME}"

        FRONTEND_CONTAINER_NAME = "${APP_NAME}-frontend-${ENV_NAME}"
        BACKEND_API_CONTAINER_NAME = "${APP_NAME}-api-${ENV_NAME}"
        BACKEND_WORKER_CONTAINER_NAME = "${APP_NAME}-worker-${ENV_NAME}"
        BACKEND_BEAT_CONTAINER_NAME = "${APP_NAME}-beat-${ENV_NAME}"

        BACKEND_HEALTH_MAX_ATTEMPTS = '36'
        BACKEND_HEALTH_INTERVAL_SEC = '5'
        WORKER_HEALTH_MAX_ATTEMPTS = '12'
        WORKER_HEALTH_INTERVAL_SEC = '5'
        FRONTEND_HEALTH_MAX_ATTEMPTS = '24'
        FRONTEND_HEALTH_INTERVAL_SEC = '5'
    }

    stages {
        stage('Validate Pipeline Configuration') {
            steps {
                script {
                    validateNoPlaceholder('GITLAB_REGISTRY', env.GITLAB_REGISTRY)
                    validateNoPlaceholder('GITLAB_IMAGE', env.GITLAB_IMAGE)
                    validateNoPlaceholder('ENV_NAME', env.ENV_NAME)
                    validateNoPlaceholder('SSH_CREDENTIALS_ID', env.SSH_CREDENTIALS_ID)
                    validateNoPlaceholder('REMOTE_HOST_CREDENTIALS_ID', env.REMOTE_HOST_CREDENTIALS_ID)
                    validateNoPlaceholder('REGISTRY_CREDENTIALS_ID', env.REGISTRY_CREDENTIALS_ID)
                    validateNoPlaceholder('DISCORD_WEBHOOK_CREDENTIALS_ID', env.DISCORD_WEBHOOK_CREDENTIALS_ID)
                    validateNoPlaceholder('DOCKER_NETWORKS', env.DOCKER_NETWORKS)
                    validateNoPlaceholder('BACKEND_ENV_FILE_PATH', env.BACKEND_ENV_FILE_PATH)
                    validateNoPlaceholder('FRONTEND_API_BASE_URL', env.FRONTEND_API_BASE_URL)
                    validateNoPlaceholder('BACKEND_PUBLIC_HEALTH_URL', env.BACKEND_PUBLIC_HEALTH_URL)
                }
            }
        }

        stage('AI Report Builder Environment') {
            steps {
                script {
                    discordNotify('started', 3447003, 'Pipeline Started', "AI Report Builder pipeline started for **${APP_NAME}** (${ENV_NAME})")
                }
                echo "Running AI Report Builder pipeline for ${APP_NAME} (${ENV_NAME})"
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def forceBuildAll = params.FORCE_BUILD_ALL == true
                    def frontendChanged = false
                    def backendChanged = false
                    def changes = ''

                    if (forceBuildAll) {
                        echo 'FORCE_BUILD_ALL is enabled - building all app containers'
                        frontendChanged = true
                        backendChanged = true
                    } else {
                        def currentCommit = resolveCurrentCommit()
                        def baselineCommit = resolveBaselineCommit(currentCommit)

                        if (baselineCommit) {
                            echo "Detecting changes from ${shortCommit(baselineCommit)} to ${shortCommit(currentCommit)}"
                            changes = changedFilesBetween(baselineCommit, currentCommit)
                        } else {
                            def changeSetFiles = collectChangeSetFiles()

                            if (changeSetFiles) {
                                echo 'Detecting changes from Jenkins SCM changelog'
                                changes = changeSetFiles.join('\n')
                            } else {
                                echo 'No previous Jenkins git baseline or changelog found - building all app containers'
                                frontendChanged = true
                                backendChanged = true
                            }
                        }
                    }

                    echo "Changed files:\n${changes}"

                    if (!forceBuildAll && changes) {
                        def changedFiles = changes.readLines().collect { it.trim() }.findAll { it }
                        frontendChanged = frontendChanged || pathChanged(changedFiles, 'frontend')
                        backendChanged = backendChanged || pathChanged(changedFiles, 'backend')
                    }

                    env.FRONTEND_CHANGED = frontendChanged.toString()
                    env.BACKEND_CHANGED = backendChanged.toString()

                    echo "Frontend will build: ${env.FRONTEND_CHANGED}"
                    echo "Backend API/worker/beat will build: ${env.BACKEND_CHANGED}"
                }
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: env.REGISTRY_CREDENTIALS_ID,
                                                    usernameVariable: 'REGISTRY_USERNAME',
                                                    passwordVariable: 'REGISTRY_PASSWORD')]) {
                        sh "echo \"\$REGISTRY_PASSWORD\" | docker login -u \"\$REGISTRY_USERNAME\" --password-stdin ${GITLAB_REGISTRY}"
                    }
                }
            }
        }

        stage('Build Images') {
            parallel {
                stage('Build Frontend') {
                    steps {
                        script {
                            if (env.FRONTEND_CHANGED == 'true') {
                                sh """
                                    docker build -t ${FRONTEND_IMAGE_TAG} \
                                        --build-arg VITE_API_BASE=${FRONTEND_API_BASE_URL} \
                                        ./frontend
                                """
                            } else {
                                echo 'Skipping frontend build - no frontend changes detected'
                            }
                        }
                    }
                }

                stage('Build Backend') {
                    steps {
                        script {
                            if (env.BACKEND_CHANGED == 'true') {
                                sh "docker build -t ${BACKEND_IMAGE_TAG} ./backend"
                            } else {
                                echo 'Skipping backend build - no backend changes detected'
                            }
                        }
                    }
                }
            }
        }

        stage('Push Images') {
            parallel {
                stage('Push Frontend') {
                    steps {
                        script {
                            if (env.FRONTEND_CHANGED == 'true') {
                                sh "docker push ${FRONTEND_IMAGE_TAG}"
                            } else {
                                echo 'Skipping frontend push - no frontend changes detected'
                            }
                        }
                    }
                }

                stage('Push Backend') {
                    steps {
                        script {
                            if (env.BACKEND_CHANGED == 'true') {
                                sh "docker push ${BACKEND_IMAGE_TAG}"
                            } else {
                                echo 'Skipping backend push - no backend changes detected'
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy Backend API') {
            steps {
                script {
                    if (env.BACKEND_CHANGED != 'true') {
                        echo 'Skipping backend API deploy - no backend changes detected'
                        return
                    }

                    deployBackendContainer(
                        BACKEND_API_CONTAINER_NAME,
                        '--network-alias api -e RUN_MIGRATIONS_IN_ENTRYPOINT=true',
                        ''
                    )
                }
            }
        }

        stage('Deploy Backend Worker') {
            steps {
                script {
                    if (env.BACKEND_CHANGED != 'true') {
                        echo 'Skipping backend worker deploy - no backend changes detected'
                        return
                    }

                    deployBackendContainer(
                        BACKEND_WORKER_CONTAINER_NAME,
                        '--no-healthcheck -e RUN_MIGRATIONS_IN_ENTRYPOINT=false',
                        'celery -A app.workers.celery_app.celery_app worker -l info'
                    )
                }
            }
        }

        stage('Deploy Backend Beat') {
            steps {
                script {
                    if (env.BACKEND_CHANGED != 'true') {
                        echo 'Skipping backend beat deploy - no backend changes detected'
                        return
                    }

                    deployBackendContainer(
                        BACKEND_BEAT_CONTAINER_NAME,
                        '--no-healthcheck -e RUN_MIGRATIONS_IN_ENTRYPOINT=false',
                        'celery -A app.workers.beat_schedule.celery_app beat -l info'
                    )
                }
            }
        }

        stage('Deploy Frontend') {
            steps {
                script {
                    if (env.FRONTEND_CHANGED != 'true') {
                        echo 'Skipping frontend deploy - no frontend changes detected'
                        return
                    }

                    withCredentials([
                        sshUserPrivateKey(credentialsId: env.SSH_CREDENTIALS_ID,
                                        keyFileVariable: 'SSH_KEY',
                                        usernameVariable: 'SSH_USER'),
                        string(credentialsId: env.REMOTE_HOST_CREDENTIALS_ID, variable: 'REMOTE_HOST'),
                        usernamePassword(credentialsId: env.REGISTRY_CREDENTIALS_ID,
                                        usernameVariable: 'REGISTRY_USERNAME',
                                        passwordVariable: 'REGISTRY_PASSWORD')
                    ]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ${SSH_USER}@${REMOTE_HOST} << 'EOF'
                                set -e

                                echo "${REGISTRY_PASSWORD}" | docker login -u "${REGISTRY_USERNAME}" --password-stdin ${GITLAB_REGISTRY}

                                NETWORK_FLAGS=""
                                DOCKER_NETWORKS_VALUE="${DOCKER_NETWORKS}"
                                OLD_IFS="\${IFS}"
                                IFS=','
                                for network in \${DOCKER_NETWORKS_VALUE}; do
                                    NETWORK_FLAGS="\${NETWORK_FLAGS} --network \${network}"
                                done
                                IFS="\${OLD_IFS}"

                                docker stop ${FRONTEND_CONTAINER_NAME} || true
                                docker rm ${FRONTEND_CONTAINER_NAME} || true
                                docker rmi ${FRONTEND_IMAGE_TAG} || true

                                docker pull ${FRONTEND_IMAGE_TAG}

                                FRONTEND_CMD="docker run -d \\
                                    --name ${FRONTEND_CONTAINER_NAME} \\
                                    --restart unless-stopped \\
                                    \${NETWORK_FLAGS} \\
                                    ${FRONTEND_IMAGE_TAG}"
                                eval \${FRONTEND_CMD}

                                if ! docker ps -q -f name=${FRONTEND_CONTAINER_NAME} | grep -q .; then
                                    echo "Frontend container failed to start"
                                    docker logs ${FRONTEND_CONTAINER_NAME} || true
                                    exit 1
                                fi

                                docker logout ${GITLAB_REGISTRY}
EOF
                        """
                    }
                }
            }
        }

        stage('Verify Deployment Health') {
            steps {
                script {
                    def backendDeployed = env.BACKEND_CHANGED == 'true'
                    def frontendDeployed = env.FRONTEND_CHANGED == 'true'

                    if (!backendDeployed && !frontendDeployed) {
                        echo 'No app containers deployed in this run - skipping health verification'
                        return
                    }

                    withCredentials([
                        sshUserPrivateKey(credentialsId: env.SSH_CREDENTIALS_ID,
                                        keyFileVariable: 'SSH_KEY',
                                        usernameVariable: 'SSH_USER'),
                        string(credentialsId: env.REMOTE_HOST_CREDENTIALS_ID, variable: 'REMOTE_HOST')
                    ]) {
                        if (backendDeployed) {
                            waitForRemoteContainerHealth(
                                BACKEND_API_CONTAINER_NAME,
                                BACKEND_HEALTH_MAX_ATTEMPTS.toInteger(),
                                BACKEND_HEALTH_INTERVAL_SEC.toInteger(),
                                'http://127.0.0.1:8000/health',
                                'api'
                            )
                            waitForRemoteContainerHealth(
                                BACKEND_WORKER_CONTAINER_NAME,
                                WORKER_HEALTH_MAX_ATTEMPTS.toInteger(),
                                WORKER_HEALTH_INTERVAL_SEC.toInteger(),
                                'none',
                                'running'
                            )
                            waitForRemoteContainerHealth(
                                BACKEND_BEAT_CONTAINER_NAME,
                                WORKER_HEALTH_MAX_ATTEMPTS.toInteger(),
                                WORKER_HEALTH_INTERVAL_SEC.toInteger(),
                                'none',
                                'running'
                            )
                        }

                        if (frontendDeployed) {
                            waitForRemoteContainerHealth(
                                FRONTEND_CONTAINER_NAME,
                                FRONTEND_HEALTH_MAX_ATTEMPTS.toInteger(),
                                FRONTEND_HEALTH_INTERVAL_SEC.toInteger(),
                                'http://127.0.0.1:80/',
                                'http'
                            )
                        }
                    }

                    if (backendDeployed) {
                        echo "Verifying public API health at ${BACKEND_PUBLIC_HEALTH_URL}"
                        verifyPublicHealthUrl(BACKEND_PUBLIC_HEALTH_URL)
                    }

                    echo 'Deployment health verification passed'
                }
            }
        }
    }

    post {
        success {
            script {
                discordNotify('success', 5763719, 'Pipeline Succeeded', "AI Report Builder pipeline succeeded for **${APP_NAME}** (${ENV_NAME})")
            }
        }
        failure {
            script {
                discordNotify('failure', 15548997, 'Pipeline Failed', "AI Report Builder pipeline failed for **${APP_NAME}** (${ENV_NAME})")
            }
        }
        always {
            script {
                sh "docker logout ${GITLAB_REGISTRY} || true"
            }
        }
    }
}

def validateNoPlaceholder(String name, String value) {
    if (!value?.trim() || value.contains('<') || value.contains('>')) {
        error "${name} must be set explicitly in CICD/AIReportBuilder/Jenkinsfile before this pipeline can run."
    }
}

def deployBackendContainer(String containerName, String extraRunFlags, String command) {
    withCredentials([
        sshUserPrivateKey(credentialsId: env.SSH_CREDENTIALS_ID,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'),
        string(credentialsId: env.REMOTE_HOST_CREDENTIALS_ID, variable: 'REMOTE_HOST'),
        usernamePassword(credentialsId: env.REGISTRY_CREDENTIALS_ID,
                        usernameVariable: 'REGISTRY_USERNAME',
                        passwordVariable: 'REGISTRY_PASSWORD')
    ]) {
        sh """
            ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ${SSH_USER}@${REMOTE_HOST} << 'EOF'
                set -e

                echo "${REGISTRY_PASSWORD}" | docker login -u "${REGISTRY_USERNAME}" --password-stdin ${GITLAB_REGISTRY}

                NETWORK_FLAGS=""
                DOCKER_NETWORKS_VALUE="${DOCKER_NETWORKS}"
                OLD_IFS="\${IFS}"
                IFS=','
                for network in \${DOCKER_NETWORKS_VALUE}; do
                    NETWORK_FLAGS="\${NETWORK_FLAGS} --network \${network}"
                done
                IFS="\${OLD_IFS}"

                docker stop ${containerName} || true
                docker rm ${containerName} || true
                docker rmi ${BACKEND_IMAGE_TAG} || true

                docker pull ${BACKEND_IMAGE_TAG}

                BACKEND_CMD="docker run -d \\
                    --name ${containerName} \\
                    --restart unless-stopped \\
                    --env-file ${BACKEND_ENV_FILE_PATH} \\
                    ${extraRunFlags} \\
                    \${NETWORK_FLAGS} \\
                    ${BACKEND_IMAGE_TAG} ${command}"
                eval \${BACKEND_CMD}

                if ! docker ps -q -f name=${containerName} | grep -q .; then
                    echo "Backend container ${containerName} failed to start"
                    docker logs ${containerName} || true
                    exit 1
                fi

                docker logout ${GITLAB_REGISTRY}
EOF
        """
    }
}

def resolveCurrentCommit() {
    def gitCommit = env.GIT_COMMIT?.trim()

    if (isCommitAvailable(gitCommit)) {
        return gitCommit
    }

    return sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
}

def resolveBaselineCommit(String currentCommit) {
    def candidates = [
        env.GIT_PREVIOUS_SUCCESSFUL_COMMIT?.trim(),
        env.GIT_PREVIOUS_COMMIT?.trim()
    ]

    return candidates.find { commit ->
        commit && commit != currentCommit && isCommitAvailable(commit)
    }
}

def changedFilesBetween(String baselineCommit, String currentCommit) {
    return sh(
        script: "git diff --name-only '${baselineCommit}' '${currentCommit}'",
        returnStdout: true
    ).trim()
}

def collectChangeSetFiles() {
    def files = []

    currentBuild.changeSets.each { changeSet ->
        changeSet.items.each { entry ->
            entry.affectedFiles.each { file ->
                files << file.path
            }
        }
    }

    return files.unique().sort()
}

def pathChanged(List changedFiles, String directory) {
    return changedFiles.any { file ->
        file == directory || file.startsWith("${directory}/")
    }
}

def isCommitAvailable(String commit) {
    if (!isCommitSha(commit)) {
        return false
    }

    return sh(script: "git cat-file -e '${commit}^{commit}'", returnStatus: true) == 0
}

def isCommitSha(String commit) {
    return commit ==~ /^[0-9a-fA-F]{7,40}$/
}

def shortCommit(String commit) {
    return commit.take(8)
}

def waitForRemoteContainerHealth(
    String containerName,
    int maxAttempts,
    int intervalSec,
    String healthUrl,
    String mode
) {
    sh """
        ssh -o StrictHostKeyChecking=no -i \${SSH_KEY} \${SSH_USER}@\${REMOTE_HOST} \\
            "bash -s -- '${containerName}' ${maxAttempts} ${intervalSec} '${healthUrl}' '${mode}'" \\
            < CICD/scripts/wait-for-container-health.sh
    """
}

def verifyPublicHealthUrl(String healthUrl) {
    sh """
        set -e
        echo "Polling ${healthUrl} from Jenkins agent..."
        attempts=0
        max=24
        until curl -fsS '${healthUrl}' | grep -Eq '"status"[[:space:]]*:[[:space:]]*"(ok|healthy)"'; do
            attempts=\$((attempts + 1))
            if [ "\$attempts" -ge "\$max" ]; then
                echo "Public health check failed after \${max} attempts"
                curl -v '${healthUrl}' || true
                exit 1
            fi
            echo "Public health not ready (attempt \$attempts/\$max), retrying in 5s..."
            sleep 5
        done
        echo "Public health check passed"
        curl -fsS '${healthUrl}'
        echo ""
    """
}

def discordNotify(String status, int color, String title, String description) {
    try {
        withCredentials([string(credentialsId: env.DISCORD_WEBHOOK_CREDENTIALS_ID, variable: 'DISCORD_WEBHOOK')]) {
            def payload = """{
                \"username\": \"Jenkins CI\",
                \"embeds\": [{
                    \"title\": \"${title}\",
                    \"description\": \"${description}\",
                    \"color\": ${color},
                    \"fields\": [
                        {\"name\": \"Job\", \"value\": \"${env.JOB_NAME}\", \"inline\": true},
                        {\"name\": \"Build\", \"value\": \"#${env.BUILD_NUMBER}\", \"inline\": true},
                        {\"name\": \"Status\", \"value\": \"${status}\", \"inline\": true}
                    ]
                }]
            }"""
            writeFile file: 'discord-payload.json', text: payload.replaceAll("'", "")
            sh 'curl -s -H "Content-Type: application/json" -X POST -d @discord-payload.json "$DISCORD_WEBHOOK" || true'
            sh 'rm -f discord-payload.json'
        }
    } catch (Exception e) {
        echo "Discord notification failed: ${e.message}"
    }
}
